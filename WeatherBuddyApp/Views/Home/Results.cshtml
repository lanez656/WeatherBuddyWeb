@model WeatherBuddyApp.Models.City
@using WeatherBuddyApp.Services

@{
    ViewData["Title"] = Model != null ? $"Weather in {Model.CityName}" : "Error";
}

<canvas id="weatherCanvas"></canvas>

<div class="results-container">
    <a asp-action="Index" class="back-link">&larr; Back to Search</a>

    @if (ViewBag.Error != null)
    {
        <div class="error-banner">
            <p>@ViewBag.Error</p>
        </div>
    }
    else if (Model != null)
    {
        <!-- Main Card: Displays your overridden City.ToString() -->
        <div class="weather-card">
            <h2 class="city-title">@Model.CityName</h2>
            <p class= "city-country-and-state">@Model.Country, @Model.StateOrRegion, @Model.GetFormattedCoordinates()</p>

            <div class="current-weather">
                <span class="temp-display">@Model.CurrentWeather.Temperature °C</span>
                <span class="weather-condition">
                    @WeatherCodeDictionary.TranslateCode(Model.CurrentWeather.WeatherCode)
                </span>
            </div>
            <span class="sunrise-sunset-time">
                    @Model.DailyForecast.DailyForecasting.First().GetSunriseAndSunset()
            </span>
        </div>

        
        // lil map ting
        (string Label, string Value)[]? conditions = new[]
            {
                (Label: "Temperature: ", Value: $"{Model.CurrentWeather.Temperature} °C"),
                (Label: "Humidity: ", Value: $"{Model.CurrentWeather.Humidity} %"),
                (Label: "Wind: ", Value: $"{Model.CurrentWeather.Wind.WindSpeed:0.##} m/s"), // ":0.##" means show up to two decimals
            };

        <div class="conditions-section">
            <h3 class="conditions-title">Current Conditions</h3>    
            <div class="conditions-box">
                @foreach (var c in conditions)
                {
                    <div class="each-condition">
                        <span class="condition-label">@c.Label</span>
                        <span class="condition-value">@c.Value</span>
                    </div>
                }
            </div>
        </div>

        <!-- Hourly Forecast Section (Horizontal Scrollable Grid) -->
        <div class="forecast-section">
            <h3 class="forecast-title">Hourly Forecast</h3>
            
            <div class="hourly-forecast-container">
                @foreach (var hour in Model.HourlyForecast.HourlyForecasting)
                {
                    <div class="hourly-card">
                        <span class="hourly-time">@hour.Time:00</span>
                        <span class="hourly-desc">
                            @WeatherCodeDictionary.TranslateCode(hour.WeatherCode)
                        </span>
                        <span class="hourly-temp">@hour.Temperature °C</span>
                        <span class="hourly-precip">🌧️ @hour.Percipitation%</span>
                    </div>
                }
            </div>
        </div>

        <!-- Daily Forecast Section -->
        <div class="forecast-section">
            <h3 class="forecast-title">7-Day Forecast</h3>
            
            <div class="forecast-list">
                @foreach (var day in Model.DailyForecast.DailyForecasting)
                {
                    <div class="forecast-item">
                        <div class="forecast-date">
                            <strong>@day.Date</strong>
                            <span class="forecast-desc">
                                @WeatherCodeDictionary.TranslateCode(day.WeatherCode)
                            </span>
                        </div>
                        <div class="sunrise-sunset">
                            @day.GetSunriseAndSunset()
                        </div>
                        <div class="forecast-temps">
                            <span>High: <span class="temp-max"> @day.TempMax °C</span> </span>
                            <span>Low: <span class="temp-min"> @day.TempMin °C</span> </span>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/weatherBackground.js"></script>
    @if (Model?.CurrentWeather != null)
    
    {
        <script>
            @{
                var today = Model.DailyForecast.DailyForecasting.FirstOrDefault();
                var isNight = today is not null && (Model.CurrentWeather.CurrentTime < today.Sunrise || Model.CurrentWeather.CurrentTime >= today.Sunset);
            }   
            
            initWeatherBackground(@Model.CurrentWeather.WeatherCode, @isNight.ToString().ToLowerInvariant());
            
        </script>
    }
}